# byvo backend 配置示例，复制为 config.yaml 后修改

api_base_url: "http://192.168.1.20:8000"

database_url: sqlite:///./byvo.db

auth:
  # 所有客户端请求必须在 X-API-Key 中携带下列任一 key
  api_keys:
    - "replace-with-your-api-key"

volcengine:
  app_key: ""
  access_key: ""
  resource_id: "volc.seedasr.sauc.duration"
  # 火山方舟 Ark：流式纠错（Typeless 风格），需在控制台创建 API Key 与模型接入
  ark_api_key: ""
  ark_model_id: "doubao-seed-1-8-251228"
